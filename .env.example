# El panel de edición (Netlify). Nada de esto va al repo ni al navegador:
# se pone en las variables de entorno del sitio de Netlify.
#
# En local:  cp .env.example .env  &&  npm run dev:panel

# La clave que comparte el staff del sello. Larga, no memorable: es la única
# puerta que hay, y el límite de intentos del servidor es de consuelo, no una
# defensa. Cambiarla es cambiar esta variable y volver a desplegar.
PANEL_PASSWORD=

# Con qué se firma la cookie de sesión. Cualquier cosa larga y aleatoria:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Cambiarla cierra todas las sesiones abiertas, que es justo lo que se quiere
# si alguna vez hay una sospecha.
PANEL_SECRET=

# PAT fine-grained de GitHub, con `contents: write` y **solo sobre este repo**.
# Vive únicamente en el servidor: no viaja en la cookie ni en ninguna respuesta.
GITHUB_TOKEN=

GITHUB_REPO=j-mamanche/tratratrax-web

# La rama a la que commitea el panel. Para probar de verdad —guardar, ver el
# commit, ver correr Actions— se apunta primero a una rama de prueba y solo
# después a `main`.
GITHUB_BRANCH=main

# Solo para probar. Apunta la Contents API a otra parte —una API de mentira
# sobre una copia de `data/` y `media/`— y así se puede recorrer el panel
# entero, guardados incluidos, sin gastar un commit del repo de verdad.
# En Netlify no se pone: sin ella queda https://api.github.com.
# GITHUB_API=http://localhost:8787
