---
// El widget de catálogo aislado, con los datos reales y el mismo bundle que
// se carga en Cargo. Lo que se ve aquí es lo que se ve allá.
//
// El chrome de abajo es una imitación del de Cargo — está solo para que las
// proporciones del stack se juzguen bien. No es parte del widget.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TraTraTrax · preview del catálogo</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #fff;
        color: #000;
        font-family: ui-sans-serif, system-ui, sans-serif;
        overscroll-behavior: none;
      }

      .chrome {
        position: fixed;
        inset: auto 0 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 1.6rem;
        padding: 0 0.6rem;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background: #fff;
        border-top: 1px solid rgba(0, 0, 0, 0.22);
      }
      .chrome b { font-weight: 700; }
    </style>
  </head>
  <body>
    <!-- Así se calibra sin tocar el widget: las variables van en el propio
         placeholder, que es lo único que se pega en la página de Cargo. Un
         `style` inline le gana a cualquier CSS, incluido el global de Cargo. -->
    <div data-ttx="catalogo" style="--ttx-alto: calc(100svh - 1.6rem)"></div>

    <div class="chrome">
      <span>2026 © Todos los izquierdos públicos</span>
      <span>TraTraTrax</span>
      <span>Menu: About <b>Catalog</b> Merca Blog</span>
    </div>

    <!-- `data-ttx-datos` solo existe aquí: en Cargo la URL sale del propio
         src del script. -->
    <script is:inline src={`${base}ttx.js`} data-ttx-datos={`${base}data/`} defer></script>
  </body>
</html>
