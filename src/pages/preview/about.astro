---
// El widget del About aislado, con los datos reales y el mismo bundle que se
// carga en Cargo. Lo que se ve aquí es lo que se ve allá.
//
// El chrome de abajo es una imitación del de Cargo. Está solo para juzgar las
// proporciones y para ver que el widget deja su hueco; no es parte del widget.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TraTraTrax · preview del about</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        box-sizing: border-box;
        /* No es el color de nada: está para que se vea dónde termina el recorte
           de los cuatro lados. Como el papel del About es el gris del chrome
           (`#e5e5e5`), este tiene que ser bastante más oscuro o el borde del
           widget se pierde. */
        background: #b0aaa1;
        color: #000;
        font-family: ui-sans-serif, system-ui, sans-serif;
        overscroll-behavior: none;
      }

      body { padding-inline: 0.5rem; }

      @media (max-width: 819px) {
        body { padding-inline: .375rem; }
      }

      .chrome {
        position: fixed;
        inset: auto 0 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 60px;
        padding: 0 1rem;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background: #fff;
        border-top: 1px solid rgba(0, 0, 0, 0.22);
      }
      @media (max-width: 819px) {
        .chrome { padding-inline: .75rem; }
      }
      .chrome b { font-weight: 700; }
    </style>
  </head>
  <body>
    <!-- Así se calibra sin tocar el widget: las variables van en el propio
         placeholder, que es lo único que se pega en la página de Cargo. Un
         `style` inline le gana a cualquier CSS, incluido el global de Cargo.

         `--ttx-margen` recorta por los cuatro lados y `--ttx-nav-h` deja abajo
         el hueco de la barra de Cargo. -->
    <div data-ttx="about" style="--ttx-margen: calc(var(--ttx-eje-nav) * .5); --ttx-nav-h: 60px"></div>

    <div class="chrome">
      <span>2026 © Todos los izquierdos públicos</span>
      <span>TraTraTrax</span>
      <span><b>About</b> Catalog Merca Blog</span>
    </div>

    <!-- `data-ttx-datos` solo existe aquí: en Cargo la URL sale del propio
         src del script. -->
    <script is:inline src={`${base}ttx.js`} data-ttx-datos={`${base}data/`} defer></script>
  </body>
</html>
