---
/**
 * El armazón de las pantallas: la barra, el carril y la obra.
 *
 * La barra lleva lo que se hace al final —guardar y salir— y nada más. El
 * botón de guardar es uno solo para todo el studio y su lógica está en
 * `lib/barra.js`; aquí solo está el sitio donde se para.
 *
 * `carril` es un slot con nombre porque lo que va ahí cambia por pantalla: la
 * lista del catálogo, y nada en el home — que no tiene lista de la que elegir,
 * así que `sinCarril` le deja la pantalla entera.
 */
import './estilo.css';

const { titulo, actual, sinCarril = false } = Astro.props;

const paginas = [
  ['/catalogo', 'Catálogo'],
  ['/home', 'Home'],
  ['/blog', 'Blog'],
];
const nombreActual = paginas.find(([href]) => href === actual)?.[1] ?? 'Secciones';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{titulo} · TraTraTrax Studio</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <div class:list={['app', sinCarril && 'app-ancha']}>
      <header class="barra">
        <!-- La vuelta a la lista, solo en pantalla angosta y solo cuando hay
             una ficha abierta encima. Vive en la barra y no en la ficha porque
             es donde ya se busca volver, y porque una ficha que empieza con un
             botón de irse empieza mal. -->
        <button class="atras" id="volver" type="button" aria-label="Volver a la lista" data-i18n-aria-label="volver">‹</button>

        <a class="marca" href="/catalogo">TraTraTrax <small>studio</small></a>

        <nav class="barra-nav">
          {paginas.map(([href, nombre]) => (
            <a href={href} aria-current={actual === href ? 'page' : null} data-i18n={href.slice(1)}>{nombre}</a>
          ))}
        </nav>

        <details class="barra-secciones" id="seccionesMovil">
          <summary><span class="barra-secciones-label" data-i18n="secciones">Secciones</span> <span class="barra-seccion-actual" data-i18n={actual.slice(1)}>{nombreActual}</span></summary>
          <nav class="barra-menu-caja">
            {paginas.map(([href, nombre]) => (
              <a href={href} aria-current={actual === href ? 'page' : null} data-i18n={href.slice(1)}>{nombre}</a>
            ))}
          </nav>
        </details>

        <div class="barra-acciones">
          <button class="boton barra-vista" id="verVista" type="button" aria-label="Vista previa" data-i18n-aria-label="vista" data-vista={actual.slice(1)}>
            <span class="boton-icon" aria-hidden="true">◉</span><span class="largo" data-i18n="vista">Vista previa</span><span class="corto" data-i18n="vista">Vista previa</span>
          </button>
          <button class="estado" id="estadoBarra" type="button" aria-expanded="false" aria-controls="detalleCambios"></button>
          <button class="boton fuerte" id="guardar" type="button" disabled>
            <span class="boton-icon" aria-hidden="true">↑</span><span class="largo" data-i18n="guardar">Guardar cambios</span><span class="corto" data-i18n="guardarCorto">Guardar</span>
          </button>
          <form method="post" action="/api/salir">
            <button class="boton callado" type="submit"><span data-i18n="salir">Salir</span> <span class="boton-icon" aria-hidden="true">↗</span></button>
          </form>
          <button class="idioma" id="idioma" type="button" aria-label="Switch to English">EN</button>

        </div>

        <div class="barra-movil-acciones">
          <button class="boton barra-vista-movil" id="verVistaMovil" type="button" aria-label="Vista previa" data-i18n-aria-label="vista"><span aria-hidden="true">◉</span><span class="barra-vista-texto" data-i18n="vista">Vista previa</span></button>
          <button class="boton fuerte barra-guardar-movil" id="guardarMovil" type="button" disabled><span aria-hidden="true">↑</span><span data-i18n="guardarCorto">Guardar</span></button>
        </div>

        <details class="barra-opciones" id="opcionesMovil">
          <summary aria-label="Opciones" data-i18n-aria-label="opciones"><span aria-hidden="true">⋯</span></summary>
          <div class="barra-menu-caja">
            <span class="menu-barra-etiqueta" data-i18n="publicacion">Publicación</span>
            <button class="menu-barra-estado" id="estadoBarraMovil" type="button" aria-expanded="false" aria-controls="detalleCambios" disabled>Guardado</button>
            <button class="menu-barra-item" id="idiomaMovil" type="button"><span aria-hidden="true">文</span><span>English</span></button>
            <form method="post" action="/api/salir">
              <button class="menu-barra-item" type="submit"><span aria-hidden="true">↗</span><span data-i18n="salir">Salir</span></button>
            </form>
          </div>
        </details>
      </header>

      <div class="parte parte-barra" id="parteBarra" hidden></div>
      <div class="detalle-cambios" id="detalleCambios" hidden></div>

      {!sinCarril && (
        <aside class="carril">
          <slot name="carril" />
        </aside>
      )}

      <main class="obra">
        <slot />
      </main>
    </div>
    <script>
      import { montarIdioma } from './lib/idioma.js';
      import { verVista } from './lib/borrador.js';
      montarIdioma();

      document.getElementById('verVista')?.addEventListener('click', (event) => verVista(`/vista?w=${event.currentTarget.dataset.vista}`));
      document.getElementById('verVistaMovil')?.addEventListener('click', () => document.getElementById('verVista')?.click());
      document.getElementById('guardarMovil')?.addEventListener('click', () => document.getElementById('guardar')?.click());

      const menus = [document.getElementById('seccionesMovil'), document.getElementById('opcionesMovil')];
      const idiomaPrincipal = document.getElementById('idioma');
      const idiomaMovil = document.getElementById('idiomaMovil');

      const cerrarMenus = () => menus.forEach((menu) => { if (menu) menu.open = false; });
      menus.forEach((menu) => menu?.addEventListener('toggle', () => {
        if (menu.open) menus.filter((otro) => otro !== menu).forEach((otro) => { if (otro) otro.open = false; });
      }));
      idiomaMovil?.addEventListener('click', () => {
        idiomaPrincipal?.click();
        cerrarMenus();
      });
      document.getElementById('estadoBarraMovil')?.addEventListener('click', () => {
        cerrarMenus();
        document.getElementById('estadoBarra')?.click();
      });
      document.getElementById('verVistaMovil')?.addEventListener('click', cerrarMenus);
      document.getElementById('guardarMovil')?.addEventListener('click', cerrarMenus);
      addEventListener('click', (event) => {
        if (!menus.some((menu) => menu?.contains(event.target))) cerrarMenus();
      });
      addEventListener('keydown', (event) => { if (event.key === 'Escape') cerrarMenus(); });
    </script>
  </body>
</html>
